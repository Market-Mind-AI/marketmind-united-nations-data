APP_NAME=marketmind-united-nations-data
APP_ENV=local
APP_PORT=8002

DATABASE_HOST=postgres
DATABASE_PORT=5432
# Host-exposed port for this service's Postgres — must be 5435 when running
# all 5 MarketMind services together (marketmind-core's own .env expects
# UNData on 5435). See marketmind-core/docs/marketmind-setup-ecossistema.md.
DATABASE_EXTERNAL_PORT=5435
DATABASE_NAME=marketmind_united_nations_data
DATABASE_USER=marketmind
DATABASE_PASSWORD=admin

UNDATA_API_BASE_URL=https://population.un.org/dataportalapi/uiapi/v1

DEFAULT_TIMEOUT=60
DEFAULT_RETRIES=3
DEFAULT_BACKOFF=2

LOG_LEVEL=INFO
